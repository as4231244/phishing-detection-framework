{
  "manifest_version": 3,
  "name": "Phishing Detector AI",
  "version": "3.0",
  "description": "An AI-powered phishing detector with one-click privacy lockdown.",
  "permissions": [
    "tabs",
    "storage",
    "privacy",
    "contentSettings"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "robo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}